<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The Activity theme, which is what paints the window BEFORE Compose draws
        its first frame. Leaving the window background white produced a white
        flash on cold start ahead of a navy app; painting it in the brand colour
        makes the launch read as one continuous surface.

        Status and navigation bars stay transparent — MainActivity calls
        enableEdgeToEdge(), and Compose draws under both.
    -->
    <style name="Theme.ParcelWala" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
